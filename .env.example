# Database
DATABASE_URL=postgresql://croissant:CHANGE_ME@postgres:5432/croissant
PGSSL=false

# SMTP (mail.croissant.cl)
SMTP_HOST=mail.croissant.cl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=horeca@croissant.cl
SMTP_PASS=CHANGE_ME
SMTP_FROM="Croissant.cl <horeca@croissant.cl>"
HORECA_TO=horeca@croissant.cl
CONTACT_FROM="Croissant.cl <contacto@croissant.cl>"
CONTACT_TO=contacto@croissant.cl

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Solo para ejecutar `npm run admin:bootstrap`.
# No dejar ADMIN_PASSWORD guardada en producción después de crear el usuario.
ADMIN_EMAIL=
ADMIN_PASSWORD=
