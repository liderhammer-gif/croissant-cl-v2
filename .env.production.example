# Docker/PostgreSQL
POSTGRES_DB=croissant
POSTGRES_USER=croissant
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DATABASE_URL=postgresql://croissant:CHANGE_ME_LONG_RANDOM@postgres:5432/croissant
PGSSL=false

# SMTP
SMTP_HOST=mail.croissant.cl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=horeca@croissant.cl
SMTP_PASS=CHANGE_ME
SMTP_FROM="Croissant.cl <horeca@croissant.cl>"
HORECA_TO=horeca@croissant.cl
CONTACT_FROM="Croissant.cl <contacto@croissant.cl>"
CONTACT_TO=contacto@croissant.cl

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Admin bootstrap only. Remove ADMIN_PASSWORD after initial bootstrap.
ADMIN_EMAIL=jorge@laboulangerie.be
ADMIN_PASSWORD=

# Security
SESSION_SECRET=CHANGE_ME_64_CHAR_RANDOM
APP_URL=https://croissant.cl
